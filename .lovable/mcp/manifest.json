{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ldxfazzmeambbucobxav.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "hiddenhits-yourself-mcp",
      "version": "0.1.0",
      "title": "HiddenHits"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get my profile",
        "description": "Return the signed-in user's profile row and basic stats (cards and decks count).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_cards",
        "title": "List my cards",
        "description": "List the signed-in user's music cards (most recent first).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max cards to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_card",
        "title": "Create a card",
        "description": "Create a new music card for the signed-in user from a Deezer track. Use `search_deezer` first to find the track_id.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Song title."
            },
            "artist": {
              "type": "string",
              "minLength": 1,
              "description": "Artist name."
            },
            "track_id": {
              "type": "string",
              "minLength": 1,
              "description": "Deezer track id (as a string)."
            },
            "release_year": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2100
                },
                {
                  "type": "null"
                }
              ]
            },
            "album": {
              "type": "string"
            },
            "cover_url": {
              "type": "string",
              "format": "uri"
            },
            "preview_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "title",
            "artist",
            "track_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "delete_card",
        "title": "Delete a card",
        "description": "Delete one of the signed-in user's cards by id.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "card_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Card id to delete."
            }
          },
          "required": [
            "card_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_decks",
        "title": "List my decks",
        "description": "List the signed-in user's decks.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "create_deck",
        "title": "Create a deck",
        "description": "Create a new empty deck for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Deck name."
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_deck_cards",
        "title": "List cards in a deck",
        "description": "List the cards inside one of the signed-in user's decks (ordered by position).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Deck id."
            }
          },
          "required": [
            "deck_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "add_card_to_deck",
        "title": "Add card to deck",
        "description": "Add one of the signed-in user's cards to one of their decks.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "card_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "deck_id",
            "card_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_deezer",
        "title": "Search Deezer",
        "description": "Search Deezer for tracks by free text (song, artist, or both). Returns candidates with `track_id` you can pass to `create_card`.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Free-text search, e.g. 'daft punk one more time'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
